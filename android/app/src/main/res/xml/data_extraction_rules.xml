<?xml version="1.0" encoding="utf-8"?>
<!--
  Google auto-backup and phone-to-phone transfer (Android 12+). Same rules as
  backup_rules.xml: keep the POS data, skip caches.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
        <exclude domain="root" path="app_webview/Default/Service Worker/" />
        <exclude domain="root" path="app_webview/GPUCache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
        <exclude domain="root" path="app_webview/Default/Service Worker/" />
        <exclude domain="root" path="app_webview/GPUCache/" />
    </device-transfer>
</data-extraction-rules>
